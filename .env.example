# UZMARKET — пример переменных окружения.
# Для демо-режима НИЧЕГО заполнять не нужно: сайт запускается без этих значений.
# Скопируйте в .env.local только когда будете подключать Supabase.

# Публичные значения Supabase (anon-ключ защищён политиками RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Серверный ключ. НИКОГДА не добавляйте префикс NEXT_PUBLIC_ и не коммитьте значение.
SUPABASE_SERVICE_ROLE_KEY=

# Будущий платёжный провайдер (пока не используется)
PAYMENT_WEBHOOK_SECRET=
